DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
OBSERVE_APP_KEY="placeholder_key"
OBSERVE_APP_SECRET="placeholder_secret"
JWT_SECRET="change-me-in-production"
# Optional: access token TTL in seconds (default 900), refresh TTL in days (default 30)
# JWT_ACCESS_TTL_SEC=900
# REFRESH_TTL_DAYS=30
# Optional: Google OAuth client id (Google sign-in returns 400 when unset)
# GOOGLE_CLIENT_ID=""
# Optional: public base URL used in emailed auth links (default http://localhost:3000)
# APP_PUBLIC_URL="http://localhost:3000"
# Gmail SMTP for auth emails (needs a Google App Password, not the login password).
# When unset, verification/reset links are logged instead of sent.
# GMAIL_USER="you@gmail.com"
# GMAIL_APP_PASSWORD="xxxx-xxxx-xxxx-xxxx"
# First-admin bootstrap only (used by `npm run seed:admin`, never at boot).
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="change-me-immediately"