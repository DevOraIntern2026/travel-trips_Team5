// use prisma-8

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String?
  name      String?
  posts     Post[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Destination {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  city        String
  country     String
  isActive    Boolean  @default(true)
  trips       Trip[]
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model Trip {
  id            Int         @id @default(autoincrement())
  destinationId Int
  destination   Destination @relation(fields: [destinationId], references: [id])
  operatorId    Int?
  name          String
  description   String?
  durationDays  Int
  isActive      Boolean     @default(true)
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()
}
