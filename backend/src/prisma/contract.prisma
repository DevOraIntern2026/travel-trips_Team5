// use prisma-8

enum BookingStatus {
  Confirmed
  Cancelled
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String?
  name      String?
  posts     Post[]
  bookings  Booking[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Destination {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  city        String
  country     String
  isActive    Boolean  @default(true)
  trips       Trip[]
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model Trip {
  id            Int         @id @default(autoincrement())
  destinationId Int
  destination   Destination @relation(fields: [destinationId], references: [id])
  operatorId    Int?
  name          String
  description   String?
  durationDays  Int
  isActive      Boolean     @default(true)
  dates         TripDate[]
  bookings      Booking[]
  cancellationWindowHours Int @default(24)
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()
}

model TripDate {
  id        Int      @id @default(autoincrement())
  tripId    Int
  trip      Trip     @relation(fields: [tripId], references: [id])
  startDate TimestamptzString
  endDate   TimestamptzString
  price     Decimal
  capacity  Int
  isActive  Boolean  @default(true)
  bookedSeats Int @default(0)
  bookings  Booking[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@check(expression: "price >= 0", name: "tripdate_price_non_negative")
  @@check(expression: "capacity > 0", name: "tripdate_capacity_positive")
  @@check(expression: "\"endDate\" >= \"startDate\"", name: "tripdate_end_after_start")
  @@check(expression: "\"capacity\" >= \"bookedSeats\"", name: "tripdate_capacity_check")
}

model Booking {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   User     @relation(fields: [customerId], references: [id])
  tripId     Int
  trip       Trip     @relation(fields: [tripId], references: [id])
  tripDateId Int
  tripDate   TripDate @relation(fields: [tripDateId], references: [id])
  status     BookingStatus @default(Confirmed)
  price      Decimal
  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()
}
